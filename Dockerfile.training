FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code and DVC tracking pointer
COPY training/ training/
COPY data/*.dvc data/

# Copy the actual dataset hydrated by CI/host runner
COPY data/email_replies_real.parquet data/email_replies_real.parquet

# Create output and tracking directories
RUN mkdir -p artifacts /tmp/mlflow

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV GIT_PYTHON_REFRESH=quiet

CMD ["sh", "-c", "python -m training.train && python -m training.retrain"]
