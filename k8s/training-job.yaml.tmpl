apiVersion: batch/v1
kind: Job
metadata:
  name: {{JOB_NAME}}
  labels:
    app: leadsentry-training
spec:
  ttlSecondsAfterFinished: 600
  backoffLimit: 1
  template:
    metadata:
      labels:
        job-name: {{JOB_NAME}}
        app: leadsentry-training
    spec:
      restartPolicy: Never
      containers:
        - name: trainer
          image: {{IMAGE_URI}}
          imagePullPolicy: IfNotPresent
          command: ["sh", "-c", "python -m training.train && python -m training.retrain"]
          resources:
            requests:
              cpu: "250m"
              memory: "256Mi"
            limits:
              cpu: "1"
              memory: "1Gi"
          env:
            - name: MLFLOW_TRACKING_URI
              value: "{{MLFLOW_TRACKING_URI}}"
            - name: MODEL_S3_BUCKET
              value: "{{MODEL_S3_BUCKET}}"
            - name: AWS_DEFAULT_REGION
              value: "ap-south-1"
            - name: PYTHONUNBUFFERED
              value: "1"
            - name: GIT_PYTHON_REFRESH
              value: "quiet"
